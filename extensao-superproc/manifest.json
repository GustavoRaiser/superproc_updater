{
  "manifest_version": 3,
  "name": "SuperPROC",
  "version": "1.0.0",
  "description": "Extensão modular de produtividade e customização para o EPROC.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.tjsc.jus.br/*",
    "*://eproc1g.tjsc.jus.br/*",
    "*://eproc2g.tjsc.jus.br/*",
    "*://eprocwebcon.tjsc.jus.br/*",
    "*://*.jus.br/*",
    "*://www.planalto.gov.br/*",
    "*://m365.cloud.microsoft/*",
    "*://copilot.cloud.microsoft/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SuperPROC - Configurações",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tjsc.jus.br/*",
        "*://eproc1g.tjsc.jus.br/*",
        "*://eproc2g.tjsc.jus.br/*",
        "*://eprocwebcon.tjsc.jus.br/*",
        "*://*.jus.br/*",
        "*://www.planalto.gov.br/*"
      ],
      "js": [
        "v2-metrics/start-0.js",
        "core/orchestrator.js",
        "v2-metrics/end-0.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/*",
        "modules/*",
        "modules/*/*",
        "modules/*/*/*",
        "modules/editor/editor_pdf_main.js",
        "modules/editor/lib/pdfmake.min.js",
        "modules/editor/lib/vfs_fonts.js",
        "icons/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "core/background.js"
  },
  "key": ""
}
